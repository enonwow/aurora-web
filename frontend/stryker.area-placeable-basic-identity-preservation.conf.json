{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/area-placeable-basic-identity-preservation.json"
  },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral",
      "BlockStatement",
      "OptionalChaining"
    ]
  },
  "vitest": {
    "configFile": "vite.area-placeable-basic-identity-preservation-mutation.config.ts"
  },
  "mutate": [
    "src/modules/layout/application/placeableBasicIdentityPreservation.ts",
    "src/modules/layout/components/properties/PlaceablePropertiesDialog.tsx:362-364",
    "src/modules/layout/components/properties/PlaceablePropertiesDialog.tsx:513-581"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
