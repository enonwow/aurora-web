    "src/modules/layout/application/placeableTrapByteProvenance.ts:12-53",
    "src/modules/areas/application/areaSceneMapper.ts:262-262",
    "src/modules/areas/application/areaSceneMapper.ts:357-359",
    "src/modules/areas/application/areaSceneMapper.ts:775-800",
    "src/modules/layout/components/properties/PlaceablePropertiesDialog.tsx:872-878",
    "src/modules/layout/application/workspaceSceneObjectClone.ts:146-148",
    "src/modules/scene/domain/sceneFactory.ts:1983-1988"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
