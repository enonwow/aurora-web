    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:361-636",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:637-642",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:645-664",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:672-678",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:681-700",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:705-710",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:718-730",
    "src/modules/scene/domain/areaTileConnectivityDiagnostics.ts:733-774",
