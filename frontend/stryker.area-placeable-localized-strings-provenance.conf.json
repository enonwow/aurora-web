{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/area-placeable-localized-strings-provenance.json"
  },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral", "BlockStatement", "OptionalChaining", "MethodExpression"]
  },
  "vitest": {
    "configFile": "vite.area-placeable-localized-strings-provenance-mutation.config.ts"
  },
  "mutate": [
    "src/modules/scene/domain/placeableLocalizedStrings.ts",
    "src/modules/areas/adapters/httpAreaApiPort.ts:305-312",
    "src/modules/areas/adapters/httpAreaApiPort.ts:991-1012",
    "src/modules/areas/application/areaSceneMapper.ts:278-281",
    "src/modules/areas/application/areaSceneMapper.ts:406-408",
    "src/modules/layout/application/workspaceSceneObjectClone.ts:166-168"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
