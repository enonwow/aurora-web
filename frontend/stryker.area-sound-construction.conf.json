{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/area-sound-construction.json"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.area-sound-construction-mutation.config.ts"
  },
  "mutate": [
    "src/modules/scene/domain/areaWaypointConstructionProfile.ts"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"],
  "timeoutMS": 20000
}
