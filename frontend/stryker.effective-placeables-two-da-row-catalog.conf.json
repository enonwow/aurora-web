{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/effective-placeables-two-da-row-catalog.json"
  },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "mutator": {
    "excludedMutations": ["ObjectLiteral", "BlockStatement", "OptionalChaining", "StringLiteral", "ArrayDeclaration", "MethodExpression"]
  },
  "vitest": {
    "configFile": "vite.effective-placeables-two-da-row-catalog-mutation.config.ts"
  },
  "mutate": [
    "src/modules/placeables/adapters/httpPlaceableApiPort.ts:132-193",
    "src/modules/placeables/adapters/httpPlaceableApiPort.ts:1597-1612",
    "src/modules/placeables/adapters/httpPlaceableApiPort.ts:1807-1858"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
