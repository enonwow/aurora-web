{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "off",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "mutate": [
    "src/modules/auth/contractSchemas.ts",
    "src/modules/layout/roleTopbarPolicy.ts",
    "src/modules/layout/roleSidebarPolicy.ts",
    "src/modules/layout/layoutSettings.ts",
    "src/modules/layout/workspaceOptionSettings.ts",
    "src/modules/layout/viewportPointerPolicy.ts",
    "src/modules/scene/adapters/localDraftStore.ts",
    "src/modules/scene/adapters/localStorageSceneDraftPort.ts",
    "src/modules/scene/domain/sceneHistory.ts",
    "src/modules/scene/application/sceneAuthoringFacade.ts",
    "src/modules/scene/application/sceneCanvasFacade.ts",
    "src/modules/scene/application/sceneFacadeBundle.ts",
    "src/modules/scene/application/sceneViewportPort.ts",
    "src/modules/scene/composition/createBrowserSceneFacadeBundle.ts",
    "src/modules/scene/composition/createBrowserSceneViewportPort.ts"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"],
  "timeoutMS": 10000
}

