{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/area-update.json"
  },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "mutator": {
    "excludedMutations": ["StringLiteral", "Regex", "ArithmeticOperator", "OptionalChaining", "ObjectLiteral", "BlockStatement"]
  },
  "vitest": {
    "configFile": "vite.area-update-mutation.config.ts"
  },
  "mutate": [
    "src/modules/areas/application/areaUpdateDraftAdmission.ts:7-28",
    "src/modules/areas/application/areaUpdateFacade.ts:22-60",
    "src/modules/areas/adapters/httpAreaUpdateApiPort.ts:258-400"
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
