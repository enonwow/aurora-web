{
  "name": "aurora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/managed-service-runner.cjs frontend-vite 5173 node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs",
    "test:unit": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run tests/unit",
    "test:unit:focused": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "test:performance": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run tests/performance-benchmarks --maxWorkers=1",
    "test:vfx:unit": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run tests/unit/modules/vfx tests/unit/modules/layout/workspaceObjectMeshLayer.vfxRenderMode.test.ts tests/unit/modules/layout/workspaceObjectMeshLayer.canonicalVfxRenderer.test.ts tests/unit/modules/layout/auroraVfxSceneRuntime.test.ts tests/unit/modules/layout/auroraVfxRenderQueue.test.ts tests/unit/modules/layout/auroraVfxCanonicalRenderer.test.ts tests/unit/modules/scene/domain/auroraVfxPayload.test.ts tests/unit/modules/scene/domain/auroraVfxClaimState.test.ts tests/unit/app/App.vfxFixtureRunner.test.tsx",
    "test:regression": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run tests/regression-smoke",
    "test:unit:coverage": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run tests/unit --coverage",
    "test:regression:coverage": "node --max-old-space-size=1024 ./node_modules/vitest/vitest.mjs run tests/regression-smoke --coverage --coverage.include=src/App.tsx --coverage.include=src/modules/layout/components/WorkspaceTopbar.tsx --coverage.include=src/modules/layout/components/WorkspaceLayout.tsx --coverage.include=src/modules/layout/components/SceneObjectListPanel.tsx",
    "test:mutation": "node ../scripts/optional-mutation-runner.cjs",
    "test:mutation:app-auth-storage-refresh": "node ../scripts/optional-mutation-runner.cjs stryker.app-auth-storage-refresh.conf.json",
    "test:mutation:area-placeable-localized-strings-provenance": "node ../scripts/optional-mutation-runner.cjs stryker.area-placeable-localized-strings-provenance.conf.json",
    "test:all": "npm run test:unit && npm run test:regression"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@stryker-mutator/core": "^9.2.0",
    "@stryker-mutator/typescript-checker": "^9.2.0",
    "@stryker-mutator/vitest-runner": "^9.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.7"
  }
}
