# Host-side source directories used only when Docker Compose creates containers.
# Copy this file to .env and change the values for the machine running Docker.
# The frontend shows these real host paths; /host/... aliases remain internal.
NWN_USER_DIR_HOST=/absolute/path/to/Neverwinter Nights user directory
NWN_INSTALL_DIR_HOST=/absolute/path/to/Neverwinter Nights installation

# Optional. An empty in-repository directory is mounted when this is unset.
# A configured value is visible to the backend as /host/aurora-reference.
AURORA_REFERENCE_DIR_HOST=
