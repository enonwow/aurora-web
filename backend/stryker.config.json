{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "checkers": ["typescript"],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress"],
  "mutate": [
    "src/modules/auth/adapters/inbound/http/access.guard.ts",
    "src/modules/auth/domain/auth.policy.ts",
    "src/modules/auth/application/auth.application.service.ts",
    "src/modules/catalog/application/catalog.application.service.ts",
    "src/modules/areas/application/areas.application.service.ts",
    "src/common/http/cors.ts"
  ],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.mutation.config.js",
    "enableFindRelatedTests": true
  }
}
