{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "checkers": [],
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["/docs"],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/area-placeable-construction.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "mutator": {
    "excludedMutations": ["StringLiteral", "Regex"]
  },
  "mutate": [
    "src/modules/areas/domain/area-placeable-construction-profile.ts",
    "src/modules/areas/domain/area-update-draft-projector.ts:327-407",
    "src/modules/areas/adapters/outbound/blob/aurora-gff-area-object-pair-writer.ts:275-330",
    "src/modules/areas/adapters/outbound/blob/aurora-gff-area-object-pair-writer.ts:570-752",
    "src/modules/areas/adapters/outbound/blob/nwn-base-key-area-object-blueprint-source.adapter.ts:40-100"
  ],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.mutation.area-sound-construction.config.js",
    "enableFindRelatedTests": false
  }
}
