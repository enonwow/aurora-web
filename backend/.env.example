NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://aurora:aurora@postgres:5432/aurora_web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTRACT_VERSION=1.0.0
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs-json
AUTH_REPOSITORY_DRIVER=postgres
SESSION_TTL_SECONDS=3600
PROCESSING_CACHE_L1_MAX_ENTRIES=2000
PROCESSING_CACHE_L1_TTL_SECONDS=900
PROCESSING_CACHE_L1_CATALOG_MAX_ENTRIES=1200
PROCESSING_CACHE_L1_AREA_MAX_ENTRIES=800
PROCESSING_CACHE_L1_CATALOG_MAX_ENTRY_BYTES=262144
PROCESSING_CACHE_L1_AREA_MAX_ENTRY_BYTES=1048576
PROCESSING_CACHE_L1_ADMISSION_HITS=2
PROCESSING_CACHE_L1_ADMISSION_WINDOW_SECONDS=300
PROCESSING_CACHE_L2_AREA_TIMEOUT_MS=5000
PROCESSING_CACHE_L2_TILE_TIMEOUT_MS=5000
RUNTIME_SETTINGS_BOOTSTRAP_SYNC=false
AURORA_DERIVED_ASSET_CONVERTER_COMMAND=node
AURORA_DERIVED_ASSET_CONVERTER_ARGS=["C:/Projects/aurora-web/backend/dist/scripts/aurora-mdl-to-glb.js","--input","{source}","--output","{output}","--resref","{resref}","--extension","{extension}"]
AURORA_DERIVED_ASSET_CONVERTER_TIMEOUT_MS=30000
AURORA_DERIVED_ASSET_MAX_MODELS=200
AURORA_DERIVED_ASSET_OUTPUT_EXTENSION=glb
# Generate with `npm run areas:tile-certification:publish -- ... --execute`.
# Local source-bound publication example:
# AURORA_AREA_CERTIFICATION_REPORT_PATH=../output/proof/area-tile-certification-publication-v1-source-bound-2026-08-21/release-report.json
AURORA_AREA_CERTIFICATION_REPORT_PATH=
# Optional external NWScript compiler provider. Leave all five identity fields
# empty to keep compilation disabled. When enabled, configure exact absolute
# paths and hashes; the executable and language specification are never
# discovered by filename alone.
AURORA_NWNSCRIPT_COMPILER_PATH=
AURORA_NWNSCRIPT_COMPILER_SHA256=
AURORA_NWNSCRIPT_COMPILER_VERSION_MARKER=
AURORA_NWNSCRIPT_LANGUAGE_SPEC_PATH=
AURORA_NWNSCRIPT_LANGUAGE_SPEC_SHA256=
# Semicolon-separated absolute directories. Every plain file is hash-bound and
# copied into the invocation-owned provider directory before execution.
AURORA_NWNSCRIPT_RUNTIME_LIBRARY_DIRS=
AURORA_NWNSCRIPT_COMPILER_TIMEOUT_MS=10000
AURORA_NWNSCRIPT_COMPILER_OUTPUT_BYTES=65536
AURORA_NWNSCRIPT_COMPILER_ARTIFACT_BYTES=4194304
AURORA_PLACEABLE_BATCH_CONCURRENCY=4
AURORA_ITEM_GENERATOR_SOURCE_DIRS=/host/aurora-reference/item-retail-extract/utg
