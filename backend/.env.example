NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://aurora:aurora@postgres:5432/aurora_web
CORS_ALLOWED_ORIGINS=http://localhost:5173
CONTRACT_VERSION=1.0.0
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs-json
AUTH_REPOSITORY_DRIVER=postgres
SESSION_TTL_SECONDS=3600
PROCESSING_CACHE_L1_MAX_ENTRIES=2000
PROCESSING_CACHE_L1_TTL_SECONDS=900
PROCESSING_CACHE_L1_CATALOG_MAX_ENTRIES=1200
PROCESSING_CACHE_L1_AREA_MAX_ENTRIES=800
PROCESSING_CACHE_L1_CATALOG_MAX_ENTRY_BYTES=262144
PROCESSING_CACHE_L1_AREA_MAX_ENTRY_BYTES=1048576
PROCESSING_CACHE_L1_ADMISSION_HITS=2
PROCESSING_CACHE_L1_ADMISSION_WINDOW_SECONDS=300
