{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "checkers": [],
"concurrency": 1,
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["docs/**", "reports/**", "output/**"],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/effective-traps-two-da.json"
  },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "mutator": {
    "excludedMutations": ["StringLiteral", "Regex", "ArithmeticOperator", "OptionalChaining", "ObjectLiteral", "BlockStatement"]
  },
  "mutate": [
    "src/modules/catalog/domain/effective-traps-two-da.ts:55-201",
    "src/modules/catalog/domain/effective-traps-two-da.ts:203-290"
  ],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.mutation.effective-traps-two-da.config.js",
    "enableFindRelatedTests": false
  }
}
