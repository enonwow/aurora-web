{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "maxWorkers": 2,
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "modulePathIgnorePatterns": ["<rootDir>/.stryker-tmp"],
  "testPathIgnorePatterns": ["<rootDir>/.stryker-tmp"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node"
}
