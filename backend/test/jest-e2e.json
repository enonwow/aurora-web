{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "maxWorkers": 1,
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "modulePathIgnorePatterns": ["<rootDir>/.stryker-tmp"],
  "testPathIgnorePatterns": ["<rootDir>/.stryker-tmp"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "isolatedModules": true
        },
        "diagnostics": false
      }
    ]
  },
  "testEnvironment": "node"
}
