{
  "name": "aurora-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:unit": "jest --config ./jest.unit.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:regression": "jest --config ./test/jest-e2e.json",
    "test:mutation": "stryker run",
    "test:mutation:catalog": "stryker run stryker.catalog.config.json",
    "test:mutation:catalog:service": "stryker run stryker.catalog.service.config.json",
    "test:mutation:catalog:helpers": "stryker run stryker.catalog.helpers.config.json",
    "test:mutation:areas": "stryker run stryker.areas.config.json",
    "test:mutation:areas:parser": "stryker run stryker.areas.parser.config.json",
    "test:mutation:areas:repository": "stryker run stryker.areas.repository.config.json",
    "test:mutation:areas:batches": "npm run test:mutation:areas:parser && npm run test:mutation:areas:repository",
    "test:mutation:tiles": "stryker run stryker.tiles.config.json",
    "test:mutation:sounds": "stryker run stryker.sounds.config.json",
    "test:mutation:auth": "stryker run stryker.auth.config.json",
    "test:mutation:cors": "stryker run stryker.cors.config.json",
    "test:mutation:staged": "npm run test:mutation:cors && npm run test:mutation:auth && npm run test:mutation:areas && npm run test:mutation:tiles && npm run test:mutation:catalog:service && npm run test:mutation:catalog:helpers",
    "test:mutation:runtime-settings": "npx stryker run stryker.runtime-settings.config.json",
    "bench:placeables": "ts-node --transpile-only scripts/run-placeable-bench.ts",
    "bench:tiles": "ts-node --transpile-only scripts/run-tile-bench.ts",
    "bench:sounds": "ts-node --transpile-only scripts/run-sound-bench.ts",
    "bench:algorithms": "ts-node --transpile-only scripts/run-algorithm-bench.ts",
    "bench:cache:integration": "ts-node --transpile-only scripts/run-cache-e2e-bench.ts",
    "bench:cache:e2e": "npm run bench:cache:integration",
    "cache:module:sync": "ts-node --transpile-only scripts/run-module-cache-sync.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-fastify": "^11.1.8",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^5.8.2",
    "mysql2": "^3.15.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.8",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.5",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
