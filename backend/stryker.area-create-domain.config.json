{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "checkers": [],
  "concurrency": 1,
  "maxTestRunnerReuse": 20,
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["/docs"],
  "reporters": ["clear-text"],
  "mutate": [
    "src/modules/areas/domain/area-create-idempotency.ts",
    "src/modules/areas/domain/area-create-journal-policy.ts"
  ],
  "tsconfigFile": "tsconfig.json",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.mutation.area-create-control.config.js",
    "enableFindRelatedTests": false
  }
}
